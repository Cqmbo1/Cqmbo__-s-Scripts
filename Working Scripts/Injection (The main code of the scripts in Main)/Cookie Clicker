// ============================================================
// --- CGX CONFIG SYSTEM (localStorage persistence) ---
// ============================================================
const CGX_KEY = 'cgx_config';

// Get the full saved config object
function cgxConfigGet() {
    try { return JSON.parse(localStorage.getItem(CGX_KEY) || '{}'); }
    catch (e) { return {}; }
}

// Save a key. Pass value=null to delete the key (i.e. feature is disabled).
function cgxConfigSave(key, value) {
    const c = cgxConfigGet();
    if (value === null) { delete c[key]; } else { c[key] = value; }
    localStorage.setItem(CGX_KEY, JSON.stringify(c));
}

// Read one key from the config
function cgxConfigRead(key) {
    return cgxConfigGet()[key] ?? null;
}

// Toggle the green "active" highlight on a button
function setButtonActive(id, active) {
    const btn = document.getElementById(id);
    if (!btn) return;
    if (active) btn.classList.add('cgx-btn-active');
    else btn.classList.remove('cgx-btn-active');
}

// Wait for the Cookie Clicker Game object to finish loading, then call cb()
function waitForGame(cb, maxTries = 120, delay = 500) {
    let tries = 0;
    const poll = setInterval(() => {
        if (typeof Game !== 'undefined' && typeof Game.Upgrades !== 'undefined') {
            clearInterval(poll);
            cb();
        } else if (++tries >= maxTries) {
            clearInterval(poll);
        }
    }, delay);
}

