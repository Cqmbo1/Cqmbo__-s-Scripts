// Helper to clear all active automation loops before loading a fresh config live
function clearAllCgxIntervals() {
    const intervals = [
        { val: autoclickerinterval, setter: (v) => autoclickerinterval = v },
        { val: autospawngoldencookieinterval, setter: (v) => autospawngoldencookieinterval = v },
        { val: autobuyupginterval, setter: (v) => autobuyupginterval = v },
        { val: autobuyiteminterval, setter: (v) => autobuyiteminterval = v },
        { val: autobuyheavenlyupgsinterval, setter: (v) => autobuyheavenlyupgsinterval = v },
        { val: autobuyitemcustominterval, setter: (v) => autobuyitemcustominterval = v },
        { val: autobuyitemEinterval, setter: (v) => autobuyitemEinterval = v },
        { val: autobuyitemCinterval, setter: (v) => autobuyitemCinterval = v },
        { val: autokillwrinklersinterval, setter: (v) => autokillwrinklersinterval = v },
        { val: autoremovebadeffectsinterval, setter: (v) => autoremovebadeffectsinterval = v }
    ];
    intervals.forEach(item => {
        if (item.val) {
            clearInterval(item.val);
            item.setter(null);
        }
    });
}

// Overwrite entire configuration in localStorage
function saveFullConfigObject(configObj) {
    // Falls back to the standard storage key structure used by cgxConfigGet
    localStorage.setItem('cgx_config', JSON.stringify(configObj));
}

// Export options
function cgxExportToClipboard() {
    const configData = JSON.stringify(cgxConfigGet() || {});
    navigator.clipboard.writeText(configData).then(() => {
        cgxAlert('Config copied to clipboard!');
    }).catch(err => {
        cgxAlert('Failed to copy config. Check console.');
        console.error(err);
    });
}

function cgxExportToFile() {
    const configData = JSON.stringify(cgxConfigGet() || {}, null, 4);
    const blob = new Blob([configData], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `cgx_config_${Date.now()}.json`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    cgxAlert('Config file download triggered.');
}

// Handle the import choice branching
function processImportedConfig(configObj) {
    if (!configObj || typeof configObj !== 'object') {
        cgxAlert('Invalid configuration data format.');
        return;
    }

    const loadNow = confirm("Would you like to load this configuration right now? (No-refresh, updates features instantly)\n\nClick 'Cancel' to save it for your next refresh instead.");

    if (loadNow) {
        // Clear runtime state to prevent overlapping intervals
        clearAllCgxIntervals();
        // Save as current config
        saveFullConfigObject(configObj);
        // Dynamically restart UI and load changes live
        if (typeof loadConfig === 'function') {
            loadConfig(true);
        }
        cgxAlert('Configuration imported and activated live!');
    } else {
        // Save config data into a pending queue for next load
        localStorage.setItem('cgx_config_pending', JSON.stringify(configObj));
        cgxAlert('Config saved for later! It will ask to overwrite on your next page refresh.');
    }
}

// Import ingestion entrypoints
function cgxImportFromText() {
    const text = prompt("Paste your exported Cookie Grinder X configuration JSON here:");
    if (!text) return;
    try {
        const parsed = JSON.parse(text);
        processImportedConfig(parsed);
    } catch(e) {
        cgxAlert("Failed to parse config. Ensure it's valid JSON. " + (text));
    }
}

function cgxImportFromFile() {
    const input = document.createElement('input');
    input.type = 'file';
    input.accept = '.json';
    input.onchange = (e) => {
        const file = e.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = (event) => {
            try {
                const parsed = JSON.parse(event.target.result);
                processImportedConfig(parsed);
            } catch(err) {
                cgxAlert("Invalid file format. Ensure it is a valid JSON config file.");
            }
        };
        reader.readAsText(file);
    };
    input.click();
}

// Intercepts startup configurations on page refresh
function checkPendingImportsOnLoad() {
    const pendingData = localStorage.getItem('cgx_config_pending');
    if (pendingData) {
        try {
            const pendingConfig = JSON.parse(pendingData);
            const useImported = confirm("An imported configuration is waiting to be processed.\n\nClick 'OK' to load the NEWLY IMPORTED config.\nClick 'Cancel' to keep your PREVIOUS config.");

            if (useImported) {
                saveFullConfigObject(pendingConfig);
                cgxAlert("Loaded the imported config successfully!");
            } else {
                cgxAlert("Kept your old config. Imported data discarded.");
            }
        } catch(e) {
            console.error("Error reading pending configuration data", e);
        }
        localStorage.removeItem('cgx_config_pending');
    }
}

    function tryAutoLoad() {
        checkPendingImportsOnLoad();
        const config = cgxConfigGet();
        const keys = Object.keys(config);
        if (config.autoLoad?.enabled && !autoLoad.active) {
            loadConfig(false)
            autoLoad.active = true;
            cgxConfigSave('autoLoad', { enabled: true });
            setButtonActive('auto-load-config-button', true);
        }
    }

    // Auto-load config once the game is ready
    waitForGame(() => tryAutoLoad());
    //waitForGame(() => loadConfig(false));
}
