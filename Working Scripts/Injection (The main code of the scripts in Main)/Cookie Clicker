function attachButtonListeners() {

    document.getElementById('toggle-cgx-menu').addEventListener('click', () => {
        const content = document.getElementById('cgx-menu-content');
        content.style.display = content.style.display === 'none' ? 'block' : 'none';
    });

    // OPEN SESAME HACK
    document.getElementById('open-sesame-button').addEventListener('click', () => {
        if(typeof Game.OpenSesame === 'function') Game.OpenSesame();
        else cgxAlert('Game not fully loaded yet!');
    });

    document.getElementById('ruin-fun-button').addEventListener('click', async () => {
        if (await cgxConfirm('Are you sure you want to Ruin The Fun? This unlocks EVERYTHING.')) {
            if (typeof Game.RuinTheFun === 'function') Game.RuinTheFun(false);
        }
    });

    document.getElementById('max-specials-button').addEventListener('click', () => {
        if(typeof Game.MaxSpecials === 'function') {
            Game.MaxSpecials();
            cgxAlert('Specials maximized!');
        }
    });

    document.getElementById('ascend-edit-button').addEventListener('click', () => {
        if(typeof Game.EditAscend === 'function') Game.EditAscend();
    });

    document.getElementById('infinite-button').addEventListener('click', async () => {
        if (await cgxConfirm('Are you sure you want Infinite Cookies?')) {
            Game.cookies = Infinity;
            Game.cookiesEarned = Infinity;
            Game.cookiesd = Infinity;
            cgxAlert('Infinite Cookies Enabled');
        }
    });

    // CORE FEATURES from og script
    document.getElementById('free-cookies-button').addEventListener('click', async () => {
        let ans = await cgxPrompt('How many cookies do you want to earn?', 'number');
        if (ans) {
            Game.Earn(Number(ans));
            cgxAlert(`Earned ${ans} cookies.`);
        }
    });

    document.getElementById('spawn-golden-button').addEventListener('click', async () => {
        let ans = await cgxPrompt('How many golden cookies do you want to spawn?', 'number');
        if (ans && Number(ans) > 0) {
            for (let i = 0; i < Number(ans); i++) {
                new Game.shimmer("golden");
            }
            cgxAlert(`Spawned ${ans} golden cookies.`);
        }
    });

    // Click on Scroll (from v1.0)
    document.getElementById('scroll-button').addEventListener('click', async () => {
        if (!ScrollWheel.active) {
            if (await cgxConfirm('Click on Scroll is disabled. Every scroll counts as a cookie click. Activate?')) {
                ScrollWheel.active = true;
                document.onmousewheel = clickcookie;
                cgxAlert('Click on Scroll enabled.');
            }
        } else {
            if (await cgxConfirm('Click on Scroll is enabled. Deactivate?')) {
                ScrollWheel.active = false;
                document.onmousewheel = null;
                cgxAlert('Click on Scroll disabled.');
            }
        }
