    // DOM-based: buy the most expensive affordable building (green price)
    function autobuyMostExpensiveItem() {
        const items = document.getElementsByClassName('product unlocked enabled');
        const storeBulkMax = document.getElementById('storeBulkMax');
        let mostExpensive = null, highest = 0;
        for (let i = 0; i < items.length; i++) {
            if (storeBulkMax && storeBulkMax.style.visibility === 'hidden') {
                const priceEl = items[i].getElementsByClassName('price')[0];
                if (!priceEl) continue;
                if (window.getComputedStyle(priceEl).color === 'rgb(102, 255, 102)') {
                    const val = parsePriceToNumber(priceEl.textContent.trim());
                    if (val > highest) { highest = val; mostExpensive = items[i]; }
                }
            }
        }
        if (mostExpensive) mostExpensive.click();
    }

    // DOM-based: buy the cheapest affordable building (green price)
    function autobuyCheapestItem() {
        const items = document.getElementsByClassName('product unlocked enabled');
        const storeBulkMax = document.getElementById('storeBulkMax');
        let cheapest = null, lowest = Infinity;
        for (let i = 0; i < items.length; i++) {
            if (storeBulkMax && storeBulkMax.style.visibility === 'hidden') {
                const priceEl = items[i].getElementsByClassName('price')[0];
                if (!priceEl) continue;
