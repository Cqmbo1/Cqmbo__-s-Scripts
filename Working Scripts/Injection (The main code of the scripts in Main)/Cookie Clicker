            Game.SesameReset ? Game.SesameReset() : Game.HardReset(2);
        }
    });

    // ============================================================
    // INFINITE COOKIES — special toggle with cookie snapshot
    // ============================================================
    document.getElementById('infinite-button').addEventListener('click', async () => {
        if (!infiniteEnabled) {
            // --- ENABLE ---
            if (await cgxConfirm('Enable Infinite Cookies? Your current cookie count will be saved so you can restore it later.')) {
                // Snapshot current cookies before setting to Infinity
                const snap = {
                    enabled: true,
                    cookies: isFinite(Game.cookies) ? Game.cookies : 0,
                    cookiesEarned: isFinite(Game.cookiesEarned) ? Game.cookiesEarned : 0,
                    cookiesd: isFinite(Game.cookiesd) ? Game.cookiesd : 0
                };
                cgxConfigSave('infiniteCookies', snap);
                Game.cookies = Infinity;
                Game.cookiesEarned = Infinity;
                Game.cookiesd = Infinity;
                infiniteEnabled = true;
                setButtonActive('infinite-button', true);
                cgxAlert('Infinite Cookies enabled. Press again to restore original count.');
            }
        } else {
            // --- DISABLE ---
            if (await cgxConfirm('Disable Infinite Cookies and restore your original cookie count?')) {
                const snap = cgxConfigRead('infiniteCookies');
                if (snap) {
                    Game.cookies = snap.cookies;
                    Game.cookiesEarned = snap.cookiesEarned;
                    Game.cookiesd = snap.cookiesd;
                }
                cgxConfigSave('infiniteCookies', null);
                infiniteEnabled = false;
                setButtonActive('infinite-button', false);
                cgxAlert('Infinite Cookies disabled. Cookies restored.');
            }
        }
    });

    // ============================================================
    // CORE FEATURES (press-and-go — no config saved)
    // ============================================================
