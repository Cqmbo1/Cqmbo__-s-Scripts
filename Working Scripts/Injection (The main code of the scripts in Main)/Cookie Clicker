// C = disable autoclicker | E = toggle heavenly upgrades
// ============================================================
document.onkeydown = function (e) {
    e = e || window.event;
    const key = e.which || e.keyCode;
    if (key === 67 && autoclickerinterval) {   // C
        clearInterval(autoclickerinterval);
        autoclickerinterval = null;
        cgxConfigSave('autoclicker', null);
        setButtonActive('autoclicker-button', false);
        cgxAlert('Autoclicker disabled (hotkey C).');
    } else if (key === 69) {                   // E
        document.getElementById('heavenly-upgrade-button').click();
    }
};
