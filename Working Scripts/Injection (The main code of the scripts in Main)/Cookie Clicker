            cgxAlert(`Earned ${ans} cookies.`);
        }
    });

    document.getElementById('chip-button').addEventListener('click', async () => {
        let ans = await cgxPrompt('How many heavenly chips?', 'number');
        if (ans && Number(ans) > 0) {
            Game.heavenlyChips += Number(ans);
            cgxAlert('Heavenly chips added.');
        }
    });

    document.getElementById('spawn-golden-button').addEventListener('click', async () => {
        let ans = await cgxPrompt('How many golden cookies do you want to spawn?', 'number');
        if (ans && Number(ans) > 0) {
            for (let i = 0; i < Number(ans); i++) new Game.shimmer('golden');
            cgxAlert(`Spawned ${ans} golden cookies.`);
        }
    });

    // ============================================================
    // AUTOCLICKER — toggle + saves delay
    // ============================================================
    document.getElementById('autoclicker-button').addEventListener('click', async () => {
        if (autoclickerinterval) {
            clearInterval(autoclickerinterval);
            autoclickerinterval = null;
            cgxConfigSave('autoclicker', null);
            setButtonActive('autoclicker-button', false);
            cgxAlert('Autoclicker disabled.');
        } else {
            let ans = await cgxPrompt('Enter click delay in ms (e.g., 10 for fast clicks)', 'number');
            if (ans && Number(ans) > 0) {
                const delay = Number(ans);
                autoclickerinterval = setInterval(clickcookie, delay);
                cgxConfigSave('autoclicker', { enabled: true, delay });
                setButtonActive('autoclicker-button', true);
                cgxAlert('Autoclicker enabled.');
            }
        }
