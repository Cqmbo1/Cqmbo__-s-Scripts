            Date.now = originalDateNow;
            cgxAlert("Speed increase disabled");
            speedEnabled = false;
        } else {
            let ans = await cgxPrompt('How much do you want to speed up your game? (Multiplier)', 'number');
            if (ans && Number(ans) > 0) {
