};
window.cgxConfirm = function (text) {
    return new Promise(resolve => {
        Game.Prompt(`<h3>⚙️ Cookie Grinder X</h3><div class="block" style="margin-bottom:10px;">${text}</div>`, [
            ['Yes', 'Game.ClosePrompt(); window.cgxResolve(true);'],
