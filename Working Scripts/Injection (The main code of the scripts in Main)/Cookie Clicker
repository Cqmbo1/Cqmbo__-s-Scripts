                    if (val < lowest) { lowest = val; cheapest = items[i]; }
                }
            }
        }
        if (cheapest) cheapest.click();
    }

    // Convert Cookie Clicker price strings ("3.2 trillion") to a plain number
    function parsePriceToNumber(priceText) {
        const scaleMap = {
            "million": 1e6, "billion": 1e9, "trillion": 1e12, "quadrillion": 1e15, "quintillion": 1e18,
            "sextillion": 1e21, "septillion": 1e24, "octillion": 1e27, "nonillion": 1e30,
            "decillion": 1e33, "undecillion": 1e36, "duodecillion": 1e39, "tredecillion": 1e42,
            "quattuordecillion": 1e45, "quindecillion": 1e48, "sexdecillion": 1e51,
            "septendecillion": 1e54, "octodecillion": 1e57, "novemdecillion": 1e60,
            "vigintillion": 1e63, "unvigintillion": 1e66, "duovigintillion": 1e69,
            "tresvigintillion": 1e72, "quattuorvigintillion": 1e75, "quinvigintillion": 1e78,
            "sesvigintillion": 1e81, "septemvigintillion": 1e84, "octovigintillion": 1e87,
            "novemvigintillion": 1e90, "trigintillion": 1e93, "untrigintillion": 1e96,
            "duotrigintillion": 1e99, "trestrigintillion": 1e102, "quattuortrigintillion": 1e105,
            "quintrigintillion": 1e108, "sestrigintillion": 1e111, "septentrigintillion": 1e114,
            "octotrigintillion": 1e117, "noventrigintillion": 1e120, "quadragintillion": 1e123,
            "unquadragintillion": 1e126, "duoquadragintillion": 1e129, "tresquadragintillion": 1e132,
            "quattuorquadragintillion": 1e135, "quinquadragintillion": 1e138,
            "sesquadragintillion": 1e141, "septenquadragintillion": 1e144,
            "octoquadragintillion": 1e147, "novenquadragintillion": 1e150,
            "quinquagintillion": 1e153, "unquinquagintillion": 1e156, "duoquinquagintillion": 1e159,
            "tresquinquagintillion": 1e162, "quattuorquinquagintillion": 1e165,
            "quinquinquagintillion": 1e168, "sesquinquagintillion": 1e171,
            "septenquinquagintillion": 1e174, "octoquinquagintillion": 1e177,
            "novenquinquagintillion": 1e180, "sexagintillion": 1e183, "unsexagintillion": 1e186,
            "duosexagintillion": 1e189, "tresexagintillion": 1e192, "quattuorsexagintillion": 1e195,
            "quinsexagintillion": 1e198, "sessexagintillion": 1e201, "septensexagintillion": 1e204,
            "octosexagintillion": 1e207, "novensexagintillion": 1e210, "septuagintillion": 1e213,
            "unseptuagintillion": 1e216, "duoseptuagintillion": 1e219, "treseptuagintillion": 1e222,
            "quattuorseptuagintillion": 1e225, "quinseptuagintillion": 1e228,
            "seseptuagintillion": 1e231, "septenseptuagintillion": 1e234,
            "octoseptuagintillion": 1e237, "novenseptuagintillion": 1e240,
            "octogintillion": 1e243, "unoctogintillion": 1e246, "duooctogintillion": 1e249,
            "tresoctogintillion": 1e252, "quattuoroctogintillion": 1e255, "quinoctogintillion": 1e258,
            "sexoctogintillion": 1e261, "septemoctogintillion": 1e264, "octooctogintillion": 1e267,
            "novemoctogintillion": 1e270, "nonagintillion": 1e273, "unnonagintillion": 1e276,
            "duononagintillion": 1e279, "tresnonagintillion": 1e282, "quattuornonagintillion": 1e285,
            "quinnonagintillion": 1e288, "senonagintillion": 1e291, "septenonagintillion": 1e294,
            "octononagintillion": 1e297, "novenonagintillion": 1e300, "centillion": 1e303
        };
        let multiplier = 1, numberPart = priceText;
        for (const [key, value] of Object.entries(scaleMap)) {
            if (priceText.includes(key)) {
                multiplier = value;
                numberPart = priceText.replace(key, '').trim();
                break;
            }
        }
        return parseFloat(numberPart.replace(/,/g, '')) * multiplier;
    }

    // ============================================================
    // --- LOAD CONFIG (defined last so it can call all helpers above) ---
    // ============================================================
    // Reads localStorage and re-activates everything that was saved as enabled.
    // Returns the number of items restored.
    // showAlert=true is used by the manual "Load Config" button press.
    function loadConfig(showAlert = false) {
        const config = cgxConfigGet();
        const keys = Object.keys(config);
        let restored = 0;

        // Autoclicker
        if (config.autoclicker?.enabled && !autoclickerinterval) {
            autoclickerinterval = setInterval(clickcookie, config.autoclicker.delay);
            setButtonActive('autoclicker-button', true);
            restored++;
        }

        // Click on Scroll
        if (config.scroll?.enabled && !ScrollWheel.active) {
            ScrollWheel.active = true;
            document.onmousewheel = clickcookie;
            setButtonActive('scroll-button', true);
            restored++;
        }

        // Auto Spawn Golden Cookies
        if (config.autoSpawnGolden?.enabled && !autospawngoldencookieinterval) {
            spawnGoldenCount = config.autoSpawnGolden.count || 1;
            spawnGoldenInterval = config.autoSpawnGolden.interval || 1000;
            autospawngoldencookieinterval = setInterval(() => {
                for (let i = 0; i < spawnGoldenCount; i++) new Game.shimmer('golden');
            }, spawnGoldenInterval);
            setButtonActive('auto-spawn-golden-button', true);
            restored++;
        }

        // Auto Buy Upgrades
        if (config.autoBuyUpgrades?.enabled && !BuyUPGS.active) {
            BuyUPGS.active = true;
            autobuyupginterval = setInterval(buyUpgrades, 200);
            setButtonActive('upgrade-button', true);
            restored++;
        }

        // Auto Buy Heavenly Upgrades
        if (config.autoBuyHeavenly?.enabled && !BuyHeavenlyUPGS.active) {
            BuyHeavenlyUPGS.active = true;
            autobuyheavenlyupgsinterval = setInterval(buyHeavenlyUpgrades, 200);
            setButtonActive('heavenly-upgrade-button', true);
            restored++;
        }

        // Auto Buy Buildings
        if (config.autoBuyBuildings?.enabled && !BuyItems.active) {
            BuyItems.active = true;
            autobuyiteminterval = setInterval(buyItems, 200);
            setButtonActive('item-button', true);
            restored++;
        }

        // Auto Buy Custom Building
        if (config.autoBuyCustom?.enabled && !BuyItemsCustom.active) {
            const itemName = config.autoBuyCustom.itemName;
            BuyItemsCustom.active = true;
            autobuyitemcustominterval = setInterval(() => autoBuyItemsCustom(itemName), 100);
            setButtonActive('item-custom-button', true);
            restored++;
        }

        // Auto Buy Most Expensive
        if (config.autoBuyExpensive?.enabled && !BuyItemsE.active) {
            BuyItemsE.active = true;
            autobuyitemEinterval = setInterval(autobuyMostExpensiveItem, 100);
            setButtonActive('item-expensive-button', true);
            restored++;
        }

        // Auto Buy Cheapest
        if (config.autoBuyCheapest?.enabled && !BuyItemsC.active) {
            BuyItemsC.active = true;
            autobuyitemCinterval = setInterval(autobuyCheapestItem, 100);
            setButtonActive('item-cheap-button', true);
            restored++;
        }

        // Auto Kill Wrinklers
        if (config.autoKillWrinklers?.enabled && !Wrinkler.active) {
            Wrinkler.active = true;
            autokillwrinklersinterval = setInterval(killwrinklers, 500);
            setButtonActive('wrinkler-button', true);
            restored++;
        }

        // No Bad Effects
        if (config.noBadEffects?.enabled && !removebadeffects.active) {
            removebadeffects.active = true;
            const badBuffs = ['clot', 'building debuff'];
            autoremovebadeffectsinterval = setInterval(() => {
                for (let i in Game.buffs) {
                    if (badBuffs.includes(Game.buffs[i].type?.name?.toLowerCase() || Game.buffs[i].name.toLowerCase())) {
                        Game.buffs[i].time = 0;
                    }
                }
            }, 500);
            setButtonActive('effect-button', true);
            restored++;
        }

        // Speed Up Game
        if (config.speedUp?.enabled && !speedEnabled) {
            const multiplier = config.speedUp.multiplier;
            Date.now = () => originalDateNow() * multiplier;
            speedEnabled = true;
            setButtonActive('speed-button', true);
            restored++;
        }

        // Hide Notifications
        if (config.hideNotifications?.enabled && !notes.active) {
            notes.active = true;
            const notesEl = document.getElementById('notes');
            if (notesEl) notesEl.style.display = 'none';
            setButtonActive('notes-button', true);
            restored++;
        }

        if (config.hideParticles?.enabled && !particles.active) {
            particles.active = true;
            const particlesEl = document.getElementById('particles');
            if (particlesEl) particlesEl.style.display = 'none';
            setButtonActive('particles-button', true);
            restored++;
        }

        // Infinite Cookies (re-enable the toggle flag; Game.cookies is already Infinity from the game save)
        if (config.infiniteCookies?.enabled && !infiniteEnabled) {
            Game.cookies = Infinity;
            Game.cookiesEarned = Infinity;
            Game.cookiesd = Infinity;
            infiniteEnabled = true;
            setButtonActive('infinite-button', true);
            restored++;
        }

        if (showAlert) {
            cgxAlert(restored > 0
                ? `Config loaded — ${restored} feature${restored === 1 ? '' : 's'} restored.`
                : 'No config saved yet.');
        } else if (restored > 0) {
            // Silent auto-load: just a small toast so the user knows it happened
            cgxAlert(`CGX: ${restored} saved feature${restored === 1 ? '' : 's'} auto-restored.`);
        }

        return restored;
    }

