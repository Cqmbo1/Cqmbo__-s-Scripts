const tryAction = (fn, btnId, args = []) => {
    let success = false;
    try {
        if (typeof fn === "function") {
            fn(...args);
            success = true;
        }
    } catch (e) {}

    if (!success) {
        const btn = document.getElementById(btnId);
        if (btn) {
            // Force the button to be enabled and lock it
            Object.defineProperty(btn, 'disabled', {
                get: () => false,
                set: () => {}, // Ignore attempts to disable it
                configurable: true
            });

            // Ensure the attribute is also removed from the DOM
            btn.removeAttribute('disabled');
            
            // Execute the click
            btn.click();
        }
    }
};


